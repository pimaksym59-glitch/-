# Public runtime config (NEXT_PUBLIC_* only — NEVER put secrets here; they would
# be inlined into the client bundle). Validated by src/shared/config/env.ts (Zod).

# Deploy environment: local | ci | staging | production
NEXT_PUBLIC_APP_ENV=local

# Base URL for the frozen backend contract (/api/v1). Same-origin by default.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Mount React Query Devtools in development.
NEXT_PUBLIC_ENABLE_DEVTOOLS=true
