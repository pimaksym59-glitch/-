{
  "name": "console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Console — premium AI-first web client for the AI Telegram Automation Platform (FS1 Infrastructure scaffold).",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.15.9",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "boundaries": "depcruise src --config dependency-cruiser.config.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "budget": "node scripts/check-route-budget.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "size": "size-limit",
    "gate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm boundaries && pnpm test"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-tooltip": "1.1.6",
    "@tanstack/react-query": "5.66.0",
    "@tanstack/react-query-devtools": "5.66.0",
    "@tanstack/react-table": "8.20.6",
    "@tanstack/react-virtual": "3.11.2",
    "@visx/axis": "4.0.0",
    "@visx/curve": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "clsx": "2.1.1",
    "cmdk": "1.0.4",
    "lucide-react": "0.474.0",
    "next": "15.1.6",
    "nuqs": "2.3.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "react-markdown": "9.0.3",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.0",
    "shiki": "1.29.2",
    "zod": "3.24.1",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.18.0",
    "@next/eslint-plugin-next": "15.1.6",
    "@playwright/test": "1.50.0",
    "@size-limit/file": "11.1.6",
    "@storybook/addon-a11y": "8.5.3",
    "@storybook/addon-essentials": "8.5.3",
    "@storybook/addon-themes": "8.5.3",
    "@storybook/react": "8.5.3",
    "@storybook/react-vite": "8.5.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "dependency-cruiser": "16.9.0",
    "eslint": "9.18.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "26.0.0",
    "msw": "2.7.0",
    "postcss": "8.5.1",
    "prettier": "3.4.2",
    "size-limit": "11.1.6",
    "storybook": "8.5.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.21.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.0.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
