# ── Application ─────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false               # true = JSON logs (production)

# Admin API — required to use /admin/* endpoints (sent as X-Admin-Token).
# ADMIN_TOKEN=change-me

# ── PostgreSQL (pgvector) ───────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telegram_ai
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── AI Engine (Anthropic) ───────────────────────────────────
# Without a key the engine falls back to a deterministic fake client.
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
AI_EFFORT=high              # low | medium | high | xhigh | max

# ── Memory / RAG (embeddings) ───────────────────────────────
# Without a key a deterministic fake embedder is used.
EMBEDDING_PROVIDER=openai        # openai | fake
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536               # must match the Vector() column
RAG_TOP_K=5

# ── Image Engine ────────────────────────────────────────────
# Without a key a deterministic fake image provider is used.
IMAGE_PROVIDER=openai            # openai | fake
# IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
MEDIA_ROOT=media
IMAGE_SIMILARITY_THRESHOLD=5
IMAGE_MAX_REGEN=3

# ── Telegram Engine ─────────────────────────────────────────
# Without a token a fake client is used (nothing is actually sent).
# TELEGRAM_BOT_TOKEN=
METRICS_DELAY_SECONDS=3600
