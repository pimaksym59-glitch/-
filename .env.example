# .env.example — template of environment variables (NAMES ONLY, no secret values).
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed (§R12.2).
# Precedence: code defaults < config/*.yaml < .env < environment variables (§R3.4).
# Secrets are loaded ONLY from here / real env — never from config/*.yaml.

# --- environment ---
APP_ENV=development            # development | testing | staging | production
LOG_LEVEL=INFO                 # optional; DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- infrastructure (declared now; connected in later stages) ---
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/telegram_ai
# REDIS_URL=redis://localhost:6379/0
# STORAGE_DIR=./storage

# --- docker compose (Stage 3). POSTGRES_PASSWORD is REQUIRED to start the stack. ---
# In compose, DATABASE_URL/REDIS_URL are derived from these + internal hostnames.
POSTGRES_USER=telegram_ai
POSTGRES_PASSWORD=            # REQUIRED — set a strong value; never commit the real .env
POSTGRES_DB=telegram_ai

# --- SECRETS (env-only). Leave unset to use provider fakes for offline dev (§R2.10). ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=
